FROM mcr.microsoft.com/playwright:v1.64.0-noble

RUN apt-get update && apt-get install -y --no-install-recommends xvfb x11-utils gosu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .

ENV NODE_ENV=production
CMD ["bash", "scripts/start-automation-hosted.sh"]
