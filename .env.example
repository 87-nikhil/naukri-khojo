# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/naukri-khojo
# Per Node.js process. Pool capacity multiplies by the number of live processes/instances.
MONGODB_MAX_POOL_SIZE=10
# Random secret of at least 32 bytes. Required for the durable automation queue.
# Keep stable across automation service instances; losing it makes Gmail credentials unreadable.
AUTOMATION_CREDENTIAL_KEY=
# Use the same random secret in Vercel project settings to protect the cron endpoint.
CRON_SECRET=replace-with-a-long-random-secret

# Optional Mongo-backed queue for portal job hunts and local browser automation.
# `npm run start:all` runs the browser queue processor in the automation service.
# Keep false for legacy synchronous local mode.
AUTOMATION_QUEUE_ENABLED=false
AUTOMATION_QUEUE_POLL_MS=1500
AUTOMATION_RUN_LEASE_MS=90000
AUTOMATION_MAX_PARALLEL_RUNS=1
AUTOMATION_GLOBAL_MAX_RUNS=1
# Legacy direct portal job hunts (only used when the durable queue is disabled).
JOB_HUNT_MAX_PARALLEL_RUNS=4
# Time allowed for a candidate to finish interactive platform sign-in/manual browser work.
AUTOMATION_INTERACTIVE_LEASE_MS=1800000
# Stable identifier for this automation host; browser queue tasks are pinned to it.
# Defaults to hostname + a hash of AUTOMATION_DATA_DIR.
# AUTOMATION_INSTANCE_ID=automation-host-1

# For linking a hosted portal login to this local worker, set the same strong
# JWT_SECRET in both environments. Local-only use stores a stable key privately
# under .automation when this variable is omitted.
# JWT_SECRET=replace-with-the-same-long-random-secret-in-both-environments

# ── Telegram Bot (optional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Email Notifications (optional) ────────────────────────
EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_TO=you@gmail.com

# ── Server ─────────────────────────────────────────────────
PORT=3000
# Set only when deployed behind a trusted reverse proxy; Vercel defaults to one hop.
# TRUST_PROXY_HOPS=1

# ── Job Search Config ──────────────────────────────────────
RESUME_PATH=./resume.pdf
DAILY_APPLY_LIMIT=10
MIN_MATCH_SCORE=70

# ── Personal application worker (Mac must remain awake) ─────────────────────
AUTOMATION_PORT=4129
# AUTOMATION_DATA_DIR=/absolute/path/to/private/job-hunter-data
AUTOMATION_BROWSER_CHANNEL=chrome
# Browser sessions run headless by default; use dashboard Open/Sign in only when needed.

# Workday candidate account used for sign-in / account creation
# WORKDAY_EMAIL=you@example.com
# WORKDAY_PASSWORD=
# WORKDAY_PASSWORD_LONG=   (12+ characters, for Citi/Fiserv-style tenants)
